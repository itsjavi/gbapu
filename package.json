{
  "name": "gbaudio",
  "version": "1.0.1",
  "description": "Game Boy APU (DMG sound) emulator and audio compiler in TypeScript: a port of stoneface86/gbapu, plus a compiler for register command streams, offline PCM rendering and WAV export.",
  "keywords": [
    "apu",
    "audio",
    "chiptune",
    "dmg",
    "emulator",
    "game-boy",
    "gameboy",
    "synthesizer",
    "wav"
  ],
  "homepage": "https://github.com/itsjavi/gbaudio#readme",
  "bugs": {
    "url": "https://github.com/itsjavi/gbaudio/issues"
  },
  "license": "MIT",
  "author": "Javi Aguilar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsjavi/gbaudio.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scripts": "node --test \"scripts/*.test.ts\"",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check && pnpm test && pnpm test:scripts && pnpm build",
    "prepack": "pnpm build",
    "release:version": "node scripts/release.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@11.25.0"
}
